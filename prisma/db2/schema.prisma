model opitemrece {
  hos_guid                    String    @id @db.VarChar(38)
  vn                          String?   @db.VarChar(13)
  hn                          String?   @db.VarChar(9)
  an                          String?   @db.VarChar(9)
  icode                       String?   @db.VarChar(7)
  qty                         Int?
  drugusage                   String?   @db.VarChar(7)
  idr                         String?   @db.VarChar(30)
  iperday                     Int?
  iperdose                    Float?    @db.Double
  recetime                    DateTime? @db.Time(0)
  unitprice                   Float?    @db.Double
  vstdate                     DateTime? @db.Date
  vsttime                     DateTime? @db.Time(0)
  doctor                      String?   @db.VarChar(10)
  rxdate                      DateTime? @db.Date
  rxtime                      DateTime? @db.Time(0)
  sp_use                      String?   @db.VarChar(7)
  hcode                       String?   @db.VarChar(5)
  print                       String?   @db.Char(1)
  dep_code                    String?   @db.Char(3)
  finance_number               String?   @db.VarChar(7)
  discount                    Float?    @db.Double
  use_right                   String?   @db.Char(1)
  node_id                     String?   @db.Char(1)
  order_no                    Int?
  sub_type                    String?   @db.Char(1)
  pttype                      String?   @db.Char(2)
  income                      String?   @db.Char(2)
  remain                      String?   @db.Char(1)
  item_type                   String?   @db.Char(1)
  staff                       String?   @db.VarChar(25)
  doctor_lock                  String?   @db.Char(1)
  paidst                      String?   @db.Char(2)
  item_no                     Int?      @db.TinyInt
  last_modified                 DateTime? @db.DateTime(0)
  sum_price                    Float?    @db.Double
  cost                         Float?    @db.Double
  stock_department_id           Int?
  command_doctor                String?   @db.VarChar(10)
  opi_doctor_finance_type_id     Int?

  @@index([an], map: "ix_an")
  @@index([an, order_no], map: "ix_an_order_no")
  @@index([order_no, an], map: "ix_an_order_no_index")
  @@index([an, rxdate, icode], map: "ix_an_rxdate_icode")
  @@index([an, icode, rxdate], map: "ix_an_rxdate_icode_index")
  @@index([doctor], map: "ix_doctor")
  @@index([drugusage], map: "ix_drugusage")
  @@index([finance_number], map: "ix_finance_number")
  @@index([hcode], map: "ix_hcode")
  @@index([hn], map: "ix_hn")
  @@index([icode], map: "ix_icode")
  @@index([item_type], map: "ix_item_type")
  @@index([pttype], map: "ix_pttype")
  @@index([rxdate], map: "ix_rxdate")
  @@index([sub_type], map: "ix_sub_type")
  @@index([vn], map: "ix_vn")
  @@index([vstdate], map: "ix_vstdate")
  @@map("opitemrece")
}

model drugitemcode{
  id            Int         @id @default(autoincrement())
  icode         String     @db.VarChar(7)
  invcode       String     @db.VarChar(10)
  mpack         Int
  unit          String?
  
  drugitem  drugitems  @relation(fields: [icode,invcode], references: [icode,invcode])
  @@index([icode, invcode], name: "icode_invcode")
}